# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Test / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Downloaded media and output ---
# Never commit downloaded media, partial files, or output folders.
download/
downloads/
OnlyFans/
*.part
*.part.json

# --- Session / credential material (never commit) ---
# Keys, cookies, HAR captures, saved sessions.
*.har
settings.json
session.json
*.session.json
.keyring*
cookies.txt
*token*
*credential*

# --- Local-only app artifacts ---
.ofdl*
.ofdl.sqlite3
.ofdl.lock
